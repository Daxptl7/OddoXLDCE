# Postgres connection string (local Homebrew Postgres, Neon or Supabase all work)
DATABASE_URL="postgresql://USER@localhost:5432/globetrotter?schema=public"

PORT=4000
NODE_ENV=development

# Secret used to sign session JWTs — replace with a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma separated list of allowed browser origins (the Next.js frontend dev server)
CORS_ORIGIN="http://localhost:3000"

# Base URL used to build public share links (must match the frontend's origin)
PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables real LLM planning through Groq. Without this, /api/ai/* uses seeded fallback logic.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
